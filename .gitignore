# === WordPress Core (don't track WP core — it's in the Docker image) ===
/wp-admin/
/wp-includes/
/wp-*.php
!wp-config-production.php
/xmlrpc.php
/index.php
/license.txt
/readme.html

# === Keep wp-content but exclude heavy / generated dirs ===
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup*/
wp-content/ai1wm-backups/
wp-content/wflogs/

# WPvivid — backup plugin runtime + data (never commit these)
wp-content/wpvividbackups/
wp-content/wpvivid_staging/
wp-content/wpvivid_uploads/
wp-content/wpvivid_*/

# === Default / 3rd-party WP themes (only track our custom theme) ===
wp-content/themes/twenty*/
wp-content/themes/mashaussure/

# === 3rd-party WP plugins (re-installable from WP repo / vendor; don't bloat git) ===
wp-content/plugins/hello.php
wp-content/plugins/akismet/
wp-content/plugins/wpvivid-backuprestore/
wp-content/plugins/wordfence/
wp-content/plugins/wp-super-cache/
wp-content/plugins/w3-total-cache/
wp-content/plugins/wp-rocket/
wp-content/plugins/duplicator/
wp-content/plugins/all-in-one-wp-migration/
wp-content/plugins/updraftplus/

# === Backup / DB dumps / archives — never commit these ===
*.sql
*.sql.gz
*.sql.bz2
*.sqlite
*.sqlite3
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.bak
*.backup
*.dump

# === Local dev files ===
wp-config.php
wp-config-local.php
wp-config-staging.php
local-xdebuginfo.php
check_images.php
add_gallery.php
audit-pages-short.php
auth_keys.txt
phpinfo.php

# === Environment & secrets ===
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.php
credentials.php
auth.json

# === Logs & debug ===
*.log
debug.log
error_log
wp-content/debug.log
wp-content/logs/

# === OS / editor junk ===
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# === Node (if ever used) ===
node_modules/
npm-debug.log
yarn-error.log
package-lock.json.bak

# === IDE ===
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
